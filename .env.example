# Local testing only. Copy to ".env" and fill in, then run:
#   set -a; source .env; set +a; npm run digest
# NEVER commit real values. In production these live in GitHub Secrets.

# Alert threshold in percent (default 10)
GMP_THRESHOLD=10

# --- Telegram (recommended, 100% free) ---
# 1. In Telegram, message @BotFather -> /newbot -> copy the token.
# 2. Message your new bot once (say "hi").
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates -> copy "chat":{"id":...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp via Meta Cloud API (official, safe: no account-ban risk) ---
# Setup: https://developers.facebook.com -> create app (type: Business) ->
#   add "WhatsApp" product. From the WhatsApp > API Setup page copy:
WHATSAPP_TOKEN=EAAZCZBqgZAyrL8BSLaR51nMHKFb09m7fr7040Pu8ddegGcSdBpst0rYFsYEnZCwl56CgdJhxrop8qo9j5ViVU7wChZAdgBQLm6FU2UMTwTDsp5GMc1OZBP6Utvo47wmz4Idmg5yPr6ENwGcnlF121CnZBvCDamHUIeZBhTRwzvidZCymKeGucRvywK8ocgd0JlQZDZD
WHATSAPP_PHONE_NUMBER_ID=1226217063907005
# Recipient (your own verified number): country code, no "+", e.g. 9198...
WHATSAPP_TO=918126337973
# Template name is REQUIRED for the scheduled 6am push (see README). Leave the
# template blank only for testing within the 24h window (freeform text).
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US

# --- WhatsApp via Green API (unofficial, free but carries ban risk) ---
# 1. Sign up at https://green-api.com and create an instance.
# 2. Open the instance, scan the QR code with WhatsApp (Linked Devices).
# 3. Copy idInstance and apiTokenInstance from the console.
GREENAPI_ID_INSTANCE=
GREENAPI_TOKEN=
# Recipient (usually your own number): country code, no "+", e.g. 9198...
GREENAPI_TO=
# Optional: override if the console shows a different apiUrl host.
# GREENAPI_API_URL=https://api.green-api.com

# --- WhatsApp via CallMeBot (unofficial, free, sign-ups often "full") ---
# Setup: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
